<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/confirmPaymentFragment">

    <fragment
        android:id="@+id/confirmPaymentFragment"
        android:name="com.m7mdabaza.efinancetask.ui.screens.confirmPayment.ConfirmPaymentFragment"
        android:label="fragment_my_home"
        tools:layout="@layout/fragment_confirm_payment">

        <action
            android:id="@+id/action_confirmPaymentFragment_to_transactionsHistoryFragment"
            app:destination="@id/transactionsHistoryFragment" />

    </fragment>

    <fragment
        android:id="@+id/transactionsHistoryFragment"
        android:name="com.m7mdabaza.efinancetask.ui.screens.transactionsHistory.TransactionsHistoryFragment"
        android:label="fragment_my_second"
        tools:layout="@layout/fragment_transactions_history">

        <action
            android:id="@+id/action_transactionsHistoryFragment_to_confirmPaymentFragment"
            app:destination="@id/confirmPaymentFragment" />

    </fragment>

</navigation>
